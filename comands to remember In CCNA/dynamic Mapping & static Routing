****************one to one dynamic address mapping  *******************
conf t
 ip access-list standard XLATE
  permit 10.2.3.3
  permit 192.168.3.1
  permit 10.1.3.11
  end

conf t
 ip nat pool test_pool 10.10.10.1 10.10.10.254 netmask 255.255.255.0
 end

conf t
 int e0/1
  ip nat inside
  exit
 int e0/0
  ip nat outside
  exit
 ip nat inside source list XLATE pool test_pool
 end


